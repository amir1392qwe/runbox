datasource db {
  datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  }
}

generator client {
  provider = "prisma-client-js"
}

model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Creator {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  name      String
  role      String
  bio       String
  accent    String
  createdAt DateTime @default(now())
  games     Game[]
}

model Game {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  category    String
  description String
  icon        String
  accent      String
  fileUrl     String?
  fileName    String?
  fileSize    Int?
  version     String?
  downloads   Int      @default(0)
  creatorId   Int?
  creator     Creator? @relation(fields: [creatorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Message {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  content   String
  createdAt DateTime @default(now())
}
